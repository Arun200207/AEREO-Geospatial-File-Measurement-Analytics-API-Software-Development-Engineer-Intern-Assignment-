import json
import math
import tempfile
import uuid
import zipfile
from pathlib import Path, PurePosixPath
from datetime import date, datetime
from collections.abc import Mapping

import geopandas as gpd
import numpy as np
import pandas as pd

from fastapi import HTTPException
from shapely.geometry import mapping


UPLOAD_DIR = Path("data/uploads")
EXTRACT_DIR = Path("data/extracted")

MAX_ZIP_ENTRIES = 1000
MAX_UNCOMPRESSED_BYTES = 200 * 1024 * 1024
MAX_SINGLE_FILE_BYTES = 100 * 1024 * 1024

MEASURABLE_GEOMETRIES = {
    "Polygon",
    "MultiPolygon",
    "LineString",
    "MultiLineString",
}
NON_MEASURABLE_GEOMETRIES = {"Point", "MultiPoint"}


def _validate_file_id(file_id: str) -> str:
    """Accept only UUID identifiers generated by the ingestion service."""
    try:
        return str(uuid.UUID(file_id))
    except (ValueError, AttributeError, TypeError):
        raise HTTPException(400, "Invalid file identifier.")


def _json_safe(value):
    """Convert common geospatial attribute values to JSON-safe values."""
    if value is None or value is pd.NA or value is pd.NaT:
        return None

    if isinstance(value, np.generic):
        value = value.item()

    if isinstance(value, (datetime, date, pd.Timestamp)):
        return value.isoformat()

    if isinstance(value, float) and not math.isfinite(value):
        return None

    if isinstance(value, Mapping):
        return {str(k): _json_safe(v) for k, v in value.items()}

    if isinstance(value, (list, tuple)):
        return [_json_safe(v) for v in value]

    if isinstance(value, (str, int, float, bool)):
        return value

    try:
        missing = pd.isna(value)
        if isinstance(missing, (bool, np.bool_)) and missing:
            return None
    except (TypeError, ValueError):
        pass

    return str(value)


def _safe_extract_shapefile(zip_path: Path, destination: Path) -> Path:
    """Safely extract one Shapefile dataset from an uploaded ZIP."""
    destination.mkdir(parents=True, exist_ok=True)

    try:
        with zipfile.ZipFile(zip_path) as archive:
            members = archive.infolist()

            if len(members) > MAX_ZIP_ENTRIES:
                raise HTTPException(400, "ZIP contains too many entries.")

            total_size = 0
            shapefile_members = []

            for member in members:
                name = member.filename.replace("\\", "/")
                path = PurePosixPath(name)

                if (
                    name.startswith("/")
                    or ".." in path.parts
                    or (path.parts and ":" in path.parts[0])
                ):
                    raise HTTPException(400, "ZIP contains an unsafe file path.")

                unix_mode = (member.external_attr >> 16) & 0o170000
                if unix_mode == 0o120000:
                    raise HTTPException(400, "ZIP contains a symbolic link.")

                if member.is_dir():
                    continue

                total_size += member.file_size

                if member.file_size > MAX_SINGLE_FILE_BYTES:
                    raise HTTPException(413, "A ZIP entry exceeds the size limit.")

                if total_size > MAX_UNCOMPRESSED_BYTES:
                    raise HTTPException(413, "ZIP expands beyond the allowed size.")

                if name.lower().endswith(".shp"):
                    shapefile_members.append(name)

            if len(shapefile_members) != 1:
                raise HTTPException(400, "ZIP must contain exactly one .shp file.")

            archive.extractall(destination)

        shp_files = [
            p for p in destination.rglob("*")
            if p.is_file() and p.suffix.lower() == ".shp"
        ]

        if len(shp_files) != 1:
            raise HTTPException(400, "Could not locate one extracted Shapefile.")

        return shp_files[0]

    except HTTPException:
        raise
    except (zipfile.BadZipFile, OSError, EOFError, RuntimeError):
        raise HTTPException(400, "The uploaded ZIP is invalid or unreadable.")


def _load_geodata(file_id: str):
    """Load a previously accepted KML or ZIP Shapefile."""
    file_id = _validate_file_id(file_id)

    kml_path = UPLOAD_DIR / f"{file_id}.kml"
    zip_path = UPLOAD_DIR / f"{file_id}.zip"

    if kml_path.is_file():
        try:
            return gpd.read_file(kml_path, driver="KML"), "kml"
        except Exception as exc:
            raise HTTPException(
                400, "Could not read features from the uploaded KML."
            ) from exc

    if zip_path.is_file():
        EXTRACT_DIR.mkdir(parents=True, exist_ok=True)

        try:
            with tempfile.TemporaryDirectory(
                prefix=f"{file_id}_",
                dir=EXTRACT_DIR,
            ) as temp_dir:
                shp_path = _safe_extract_shapefile(
                    zip_path, Path(temp_dir)
                )
                gdf = gpd.read_file(shp_path)

            return gdf, "shapefile"

        except HTTPException:
            raise
        except Exception as exc:
            raise HTTPException(
                400,
                "Could not read Shapefile features. Check the geometry "
                "file and its required companion files.",
            ) from exc

    raise HTTPException(404, "Uploaded geospatial file was not found.")


def _extract_geodataframe(gdf, file_id: str, source_format: str) -> dict:
    """Convert a GeoDataFrame into JSON-safe feature records."""
    try:
        geometry_column = gdf.geometry.name
        dataset_crs = str(gdf.crs) if gdf.crs is not None else None
    except Exception as exc:
        raise HTTPException(
            400, "The dataset does not contain a usable geometry column."
        ) from exc

    features = []
    supported_types = {
        "Polygon", "MultiPolygon", "LineString", "MultiLineString"
    }

    for position, (_, row) in enumerate(gdf.iterrows()):
        geometry = row[geometry_column]

        if geometry is None:
            geometry_type = None
            geometry_json = None
            is_empty = None
            is_valid = None
            measurement_supported = False
            measurement_note = "null_geometry"
        else:
            geometry_type = getattr(geometry, "geom_type", type(geometry).__name__)
            is_empty = bool(geometry.is_empty)
            is_valid = bool(geometry.is_valid)

            try:
                geometry_json = _json_safe(mapping(geometry))
            except Exception:
                geometry_json = None

            if is_empty:
                measurement_supported = False
                measurement_note = "empty_geometry"
            elif not is_valid:
                measurement_supported = False
                measurement_note = "invalid_geometry"
            elif dataset_crs is None:
                measurement_supported = False
                measurement_note = "missing_crs"
            elif geometry_type not in supported_types:
                measurement_supported = False
                measurement_note = "unsupported_geometry"
            else:
                measurement_supported = True
                measurement_note = None

        properties = {
            str(column): _json_safe(value)
            for column, value in row.items()
            if column != geometry_column
        }

        features.append({
            "feature_id": str(position),
            "feature_index": position,
            "geometry_type": geometry_type,
            "geometry": geometry_json,
            "crs": dataset_crs,
            "properties": properties,
            "geometry_is_empty": is_empty,
            "geometry_is_valid": is_valid,
            "measurement_supported": measurement_supported,
            "measurement_note": measurement_note,
        })

    result = {
        "file_id": file_id,
        "source_format": source_format,
        "crs": dataset_crs,
        "feature_count": len(features),
        "features": features,
    }

    try:
        json.dumps(result, allow_nan=False)
    except (TypeError, ValueError) as exc:
        raise HTTPException(
            500, "Extracted feature data could not be serialized to JSON."
        ) from exc

    return result


def extract_features(file_id: str) -> dict:
    """Extract features and metadata from a stored geospatial file."""
    gdf, source_format = _load_geodata(file_id)
    return _extract_geodataframe(gdf, file_id, source_format)
