# --- TEST 7: 404 Error Handling for Non-existent Files ---
def test_nonexistent_file_handling():
    fake_id = str(uuid.uuid4())
    assert client.get(f"/api/files/{fake_id}/").status_code == 404
    assert client.get(f"/api/files/{fake_id}/measurements/").status_code == 400 or client.get(f"/api/files/{fake_id}/measurements/").status_code == 404
    assert client.get(f"/api/files/{fake_id}/analytics/").status_code == 404

run_test("7. Resource Not Found (404) Handling", test_nonexistent_file_handling)


