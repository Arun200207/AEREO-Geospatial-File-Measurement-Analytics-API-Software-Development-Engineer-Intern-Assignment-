# --- TEST 3: Ingestion Edge Cases & Error Handling ---
def test_ingestion_errors():
    # Unsupported extension
    resp_ext = client.post("/api/files/", files={"file": ("test.txt", b"hello", "text/plain")})
    assert resp_ext.status_code == 415

    # Malformed KML
    resp_kml = client.post("/api/files/", files={"file": ("bad.kml", b"<kml><unclosed>", "application/xml")})
    assert resp_kml.status_code == 400

    # Corrupt ZIP
    resp_zip = client.post("/api/files/", files={"file": ("bad.zip", b"not-a-zip", "application/zip")})
    assert resp_zip.status_code == 400

run_test("3. Ingestion Error Handling (415 & 400 responses)", test_ingestion_errors)


# --- TEST 4: Measurement & CRS Engine (Module 04) ---
def test_measurement_engine_logic():
    gdf = gpd.GeoDataFrame(
        {"name": ["Square", "Path"]},
        geometry=[
            Polygon([(0, 0), (1, 0), (1, 1), (0, 1), (0, 0)]),
            LineString([(0, 0), (0, 1)])
        ],
        crs="EPSG:4326"
    )
    result = measure_geodataframe(gdf)
    assert result["feature_count"] == 2
    assert result["successful_measurements"] == 2
    
    features = result["features"]
    poly_res = next(f for f in features if f["geometry_type"] == "Polygon")
    line_res = next(f for f in features if f["geometry_type"] == "LineString")
    
    assert poly_res["area_m2"] > 0
    assert poly_res["measurement_crs"] is not None
    assert line_res["length_m"] > 0

run_test("4. Measurement & Local UTM CRS Engine", test_measurement_engine_logic)


# --- TEST 5: Database Persistence & Retrieval (Module 05) ---
def test_database_persistence():
    global test_file_id
    # Trigger measurement calculation endpoint which persists results to SQLite
    meas_response = client.get(f"/api/files/{test_file_id}/measurements/")
    assert meas_response.status_code == 200
    
    # Retrieve file details route
    details_response = client.get(f"/api/files/{test_file_id}/")
    assert details_response.status_code == 200
    details = details_response.json()
    
    assert details["file_id"] == test_file_id
    assert details["status"] == "measured"
    assert len(details["measurements"]) == 1

run_test("5. Database Persistence & File Details API", test_database_persistence)


